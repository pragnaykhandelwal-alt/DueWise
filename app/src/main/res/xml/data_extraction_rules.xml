<?xml version="1.0" encoding="utf-8"?><!--
   Used on Android 12 (API 31) and higher.
   ReadyShelf keeps all household data on the phone, so every app data folder is
   excluded from cloud backup and from device-to-device transfer.
   "root" covers the app's private folders (files, databases, shared_prefs).
   See https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
