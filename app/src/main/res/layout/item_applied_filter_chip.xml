<?xml version="1.0" encoding="utf-8"?>
<!-- One chosen filter under Inventory's search box, for example "Near date" with a ✕, or the
     "Clear all" chip (InventoryActivity.showAppliedFilters). It is not a choice that stays
     checked: a tap only sets the filter back, so it is not checkable. Material chips have a 48 dp
     touch target. TalkBack reads the ✕ as "Remove Near date". -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Input"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="false"
    android:textAppearance="?attr/textAppearanceLabelLarge"
    app:closeIconVisible="true" />
