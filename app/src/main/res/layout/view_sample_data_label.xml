<?xml version="1.0" encoding="utf-8"?>
<!-- The "Sample data" strip: "Sample data: made-up items, kept apart from your own records." and,
     under it since 2026-10-19 (the student's request), "Close sample data". That asks first and
     then opens Home with the household's own records (SampleDataClose). ScreenSetup puts the
     strip right under the toolbar of every screen while the separate sample data is open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sample_data_bar"
    style="@style/ReadyShelf.SampleDataBar">

    <TextView
        android:id="@+id/sample_data_label"
        style="@style/ReadyShelf.SampleDataLabel" />

    <Button
        android:id="@+id/sample_data_close"
        style="@style/ReadyShelf.SampleDataClose" />
</LinearLayout>
